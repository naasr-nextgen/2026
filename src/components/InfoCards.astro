---
import LucideBell from '~icons/lucide/bell'
import LucideCalendarDays from '~icons/lucide/calendar-days'
import LucideBookOpen from '~icons/lucide/book-open'
import LucideClockAlert from '~icons/lucide/clock-alert'

const cards = [
	{
		icon: LucideBell,
		title: "Announcement",
		description: "Program starts promptly at 9 AM on 13 July",
		color: "bg-brand-blue text-white",
	},
	{
		icon: LucideCalendarDays,
		title: "Event",
		description: "Public Presentations — 7–9 PM on 30 July at NAASR",
		color: "bg-brand-yellow text-white",
	},
	{
		icon: LucideClockAlert,
		title: "Half Day",
		description: "To prep for 30 July evening event, we will end the day at 1 pm",
		color: "bg-brand-blue text-white",
	},
];
---

<div class="grid gap-6 grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
	{
		cards.map(({ icon: Icon, title, description, color }) => (
			<div class={`p-6 rounded-lg shadow ${color}`}>
				<Icon class="size-8 mb-3" />
				<h3 class="text-2xl mb-4">{title}</h3>
				<p class="font-semibold">{description}</p>
			</div>
		))
	}
</div>
