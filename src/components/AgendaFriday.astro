---
import LucideClock from "~icons/lucide/clock";

const schedule = [
	{ time: "9:00–10:00 AM", activity: "Morning Prep & Transportation", emoji: "☀️" },
	{ time: "10:00 AM–12:30 PM", activity: "Field Trip", emoji: "🗺️" },
	{ time: "12:30–1:30 PM", activity: "Lunch at locations in Watertown", emoji: "🍕" },
	{ time: "1:30–2:00 PM", activity: "Transport back to NAASR", emoji: "🚌" },
	{ time: "2:00–3:15 PM", activity: "Afternoon Session 1", emoji: "🧑‍💻" },
	{ time: "3:15–3:30 PM", activity: "Break", emoji: "☕️" },
	{ time: "3:30–4:30 PM", activity: "Afternoon Session 2", emoji: "📚" },
	{ time: "4:30 PM", activity: "Dismissal", emoji: "🚌" },
];
---

<div class="max-w-2xl mx-auto">
	{
		schedule.map((item) => (
			<div class="flex items-center gap-4 py-4 border-b border-gray-400/50 last:border-b-0">
				<div class="flex items-center gap-2 w-[30%] shrink-0">
					<LucideClock class="size-4 text-brand-blue" />
					<span class="font-bold">{item.time}</span>
				</div>
				<span>{item.activity}</span>
			</div>
		))
	}
</div>
