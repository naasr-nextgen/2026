---
import LucideClock from "~icons/lucide/clock";

const schedule = [
	{ time: "9:00–10:15 AM", activity: "Morning Session", emoji: "☀️" },
	{ time: "10:15–10:30 AM", activity: "Break & Guest Prep", emoji: "🌅" },
	{ time: "10:30 AM–12:00 PM", activity: "Guest Lecturer Session", emoji: "🧑‍🏫" },
	{ time: "12:00–1:00 PM", activity: "Lunch", emoji: "🍕" },
	{ time: "1:00–2:30 PM", activity: "Afternoon Session 1", emoji: "🧑‍💻" },
	{ time: "2:30–3:00 PM", activity: "Break", emoji: "☕️" },
	{ time: "3:00–4:30 PM", activity: "Afternoon Session 2", emoji: "📚" },
	{ time: "4:30 PM", activity: "Dismissal", emoji: "🚌" },
];
---

<div class="max-w-2xl mx-auto">
	{
		schedule.map((item) => (
			<div class="flex items-center gap-4 py-4 border-b border-gray-400/50 last:border-b-0">
				<div class="flex items-center gap-2 w-[30%] shrink-0">
					<LucideClock class="size-4 text-brand-blue" />
					<span class="font-bold">{item.time}</span>
				</div>
				<span>{item.activity}</span>
			</div>
		))
	}
</div>
