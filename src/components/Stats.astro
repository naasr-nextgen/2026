---
import LucideUsers from '~icons/lucide/users'
import LucideStar from '~icons/lucide/star'
import LucideRocket from '~icons/lucide/rocket'

const stats = [
    { icon: LucideRocket, label: "Inaugural Year", value: "2026" },
	{ icon: LucideUsers, label: "Faculty with PhDs", value: "10+" },
	{ icon: LucideStar, label: "Weeks of Exploration", value: "3" },
];
---

<div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3 max-w-5xl mx-auto">
	{
		stats.map((stat) => (
			<div class="rounded-2xl bg-white shadow p-8 text-center">
				<stat.icon class="mx-auto size-10 text-brand-yellow" />
				<div class="font-inter mt-3 text-4xl text-brand-blue">{stat.value}</div>
				<div class="mt-1 font-semibold">{stat.label}</div>
			</div>
		))
	}
</div>
