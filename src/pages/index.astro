---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Section.astro";
import Container from "@/components/Container.astro";
import MainHeading from "@/components/MainHeading.astro";
import Button from "@/components/buttons/Button.astro";
import Video from "@/components/Video.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import Stats from "@/components/Stats.astro";
import ProgramCards from "@/components/ProgramCards.astro";
import Agenda from "@/components/Agenda.astro";
// Page metadata
const title = "Home";
const seoTitle = "Home";
const seoDescription = "Immersive Armenian Studies: The NAASR NextGen Summer Program in Belmont, MA offers project-based learning with expert faculty & guest scholars.";
---

<Layout {title} {seoTitle} {seoDescription}>

	<Section class="relative">
		<Video
			class:list={"absolute inset-0 object-cover object-top w-full h-full z-0"}
			src="/2026/student-group-project.mp4"
			autoplay
			muted
			loop
			playsinline
			overlay="bg-white/70 z-10"
		/>

		<Container class:list={"relative z-20"}>
			<MainHeading>
				<h1 class="text-5xl tracking-wide">Welcome to NAASR NextGen Summer Armenian Studies</h1>

				<p>
					A project-driven intellectual lab where students investigate urgent questions about Armenian history, identity, memory, justice, and representation—and build something with real-world impact.
				</p>

				<div class="flex flex-wrap gap-4 justify-center md:justify-start">
					<Button href="/2026/about" variant="blue">About</Button>
					<Button href="/2026/calendar" variant="yellow">Course Calendar</Button>
				</div>
			</MainHeading>
		</Container>
	</Section>

</Layout>
