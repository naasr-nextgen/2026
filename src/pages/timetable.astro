---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Section.astro";
import Container from "@/components/Container.astro";
import MainHeading from "@/components/MainHeading.astro";
import Button from "@/components/buttons/Button.astro";
import Video from "@/components/Video.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import InfoCards from "@/components/InfoCards.astro";
import Stats from "@/components/Stats.astro";
import ProgramCards from "@/components/ProgramCards.astro";
import Agenda from "@/components/Agenda.astro";
import AgendaFriday from "@/components/AgendaFriday.astro";

// Page metadata
const title = "Daily Timetable";
const seoTitle = "Daily Timetable";
const seoDescription = "See the NAASR NextGen Summer Program Daily Timetable: View detailed timings for all activities in Belmont, MA and learn about typical days.";
---

<Layout {title} {seoTitle} {seoDescription}>

	<Section class:list={"bg-neutral-50"}>
		<Container>
			<SectionHeading>
				<h1 class="text-4xl tracking-wide">Daily Timetable</h1>
			</SectionHeading>
			<h2 class="text-brand-blue text-center">A typical Monday–Thursday at NextGen:</h2>
			<Agenda />
		</Container>
	</Section>

<hr />

<Section class:list={"bg-neutral-50 text-center"}>
		<Container>
			<h2 class="text-brand-blue">A typical Friday:</h2>
			<AgendaFriday />
		</Container>
	</Section>

</Layout>
