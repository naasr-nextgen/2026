---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Section.astro";
import Container from "@/components/Container.astro";
import MainHeading from "@/components/MainHeading.astro";
import Button from "@/components/buttons/Button.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import InfoCards from "@/components/InfoCards.astro";
import Stats from "@/components/Stats.astro";
import ProgramCards from "@/components/ProgramCards.astro";

// Page metadata
const title = "About";
const seoTitle = "About";
const seoDescription = "Immersive Armenian Studies: The NAASR NextGen Summer Program in Belmont, MA offers project-based learning with expert faculty & guest scholars.";
---

<Layout {title} {seoTitle} {seoDescription}>

	<Section class:list={"bg-neutral-50"}>
		<Container>
			<SectionHeading>
				<h1 class="text-4xl tracking-wide">About NextGen</h1>
				<p>
				For three weeks, students come together for immersive, project-driven study guided by world-class Armenian Studies faculty and guest scholars. In this hands-on program, students research, debate, design, and work in teams to craft a real digital campaign presented to a live audience. Experts drawn from leading universities and research institutions bring the living edge of scholarship directly into the classroom.
				</p>
			</SectionHeading>

			<Stats />
		</Container>
	</Section>

	<Section>
		<Container>
			<SectionHeading>
				<h2 class="text-4xl tracking-wide">Our Policies</h2>
			</SectionHeading>

			<ProgramCards />
		</Container>
	</Section>

</Layout>
