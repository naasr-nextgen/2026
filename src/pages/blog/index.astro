---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Section.astro";
import Container from "@/components/Container.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import BlogList from "@/components/BlogList.astro";

// Page metadata
const title = "News";
const seoTitle = "News";
const seoDescription = "Stay up to date with news & announcements from NAASR NextGen Summer Program faculty in Belmont, MA.";
---

<Layout {title} {seoTitle} {seoDescription}>

    <Section>
		<Container>
			<SectionHeading>
				<h1 class="text-4xl font-bold tracking-wide">Announcements & Updates</h1>
				<p>Stay up to date with announcements from NextGen faculty.</p>
			</SectionHeading>

			<BlogList />
		</Container>
	</Section>

</Layout>
